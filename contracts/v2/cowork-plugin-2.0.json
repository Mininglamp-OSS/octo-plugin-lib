{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cowork-plugin-2.0.json",
  "title": "Cowork Plugin 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin_id", "plugin_name", "plugin_type", "manifest_json", "plugin_json", "plugin_hash", "status", "created_at", "updated_at"],
  "properties": {
    "plugin_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "plugin_name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]" },
    "plugin_type": { "enum": ["expert", "skill", "expert_team", "connector"] },
    "manifest_json": { "$ref": "cowork-plugin-manifest-2.0.json" },
    "plugin_json": { "oneOf": [{ "$ref": "cowork-plugin-package-2.0.json" }, { "type": "null" }] },
    "plugin_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["ACTIVE", "ARCHIVED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
