{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cowork-plugin-revision-content-2.0.json",
  "title": "Cowork Plugin Revision Content 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin_type", "manifest_json", "plugin_json", "plugin_hash"],
  "properties": {
    "plugin_type": { "enum": ["expert", "skill", "expert_team", "connector"] },
    "manifest_json": { "$ref": "cowork-plugin-manifest-2.0.json" },
    "plugin_json": { "oneOf": [{ "$ref": "cowork-plugin-package-2.0.json" }, { "type": "null" }] },
    "plugin_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
