{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cowork-plugin-package-2.0.json",
  "title": "Cowork Plugin Package 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "attachments"],
  "properties": {
    "$schema": { "const": "cowork-plugin-package-2.0.json" },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": { "enum": ["mcp", "cli", "skill-only", "openconnector"] },
        "source": { "type": "string", "minLength": 1, "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]" }
      }
    },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } }
  },
  "$defs": {
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_type", "mime_type"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$" },
        "content_type": { "enum": ["raw", "storage"] },
        "mime_type": { "type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[^/\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+/[^/\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+$" },
        "raw_content": { "type": "string" },
        "content_size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "content_type": { "const": "raw" } }, "required": ["content_type"] },
          "then": {
            "required": ["raw_content"],
            "properties": {
              "raw_content": {},
              "content_size": false,
              "content_hash": false
            }
          }
        },
        {
          "if": { "properties": { "content_type": { "const": "storage" } }, "required": ["content_type"] },
          "then": {
            "required": ["content_size", "content_hash"],
            "properties": {
              "raw_content": false,
              "content_size": {},
              "content_hash": {}
            }
          }
        }
      ]
    }
  }
}
